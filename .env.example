# ==============================================================================
# GenViet Environment Variables Template (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp tin này thành `.env.local`: cp .env.example .env.local
# 2. Điền các giá trị cấu hình tương ứng với môi trường phát triển của bạn.
# 3. TUYỆT ĐỐI KHÔNG commit tệp tin `.env.local` hoặc secret thật vào Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC ENVIRONMENT VARIABLES (Được phép xuất hiện trên Trình duyệt Client)
# ------------------------------------------------------------------------------
# URL của Supabase Project (Local hoặc Cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Anon Key của Supabase (An toàn cho client, được bảo vệ qua RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (CHỈ DÙNG TRÊN SERVER - BẢO MẬT TUYỆT ĐỐI)
# ------------------------------------------------------------------------------
# Service Role Key (Chỉ dùng cho server scripts/maintenance, KHÔNG BAO GIỜ đưa ra client)
# Trạng thái hiện tại: Chưa dùng trong Phase P05 (Chuẩn bị cho Phase P06+)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret bảo vệ endpoint tác vụ định kỳ Cron / Heartbeat (Tùy chọn tương lai)
CRON_SECRET=your-internal-cron-secret-here
