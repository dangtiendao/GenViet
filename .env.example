# ==============================================================================
# GenViet Environment Variables Template (.env.example)
# Phase: P06 (Thiết lập Supabase & Môi trường Ban đầu)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp tin này thành `.env.local`: cp .env.example .env.local
# 2. Điền các giá trị cấu hình tương ứng với môi trường phát triển của bạn.
# 3. TUYỆT ĐỐI KHÔNG commit tệp tin `.env.local` hoặc secret thật vào Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC ENVIRONMENT VARIABLES (Được phép xuất hiện trên Trình duyệt Client)
# ------------------------------------------------------------------------------
# URL của Supabase Project (Local stack hoặc Cloud Development Project)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Anon Key / Publishable Key (An toàn cho client, được bảo vệ qua RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (CHỈ DÙNG TRÊN SERVER - BẢO MẬT TUYỆT ĐỐI)
# ------------------------------------------------------------------------------
# Service Role Key / Secret Key (Chỉ dùng cho background scripts, KHÔNG đưa ra client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# Direct Database URL (Chỉ dùng cho migration tool / CLI scripts, KHÔNG đưa ra client)
# Direct connection (Session mode): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Project Ref (Dành cho CLI link/push scripts - tùy chọn)
SUPABASE_PROJECT_REF=your-supabase-project-ref-here

# Secret bảo vệ endpoint tác vụ định kỳ Cron / Heartbeat (Tùy chọn tương lai)
CRON_SECRET=your-internal-cron-secret-here
